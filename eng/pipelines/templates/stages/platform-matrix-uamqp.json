{
  "displayNames": {
    "_": ""
  },
  "include": [
    {
      "StaticConfigs": {
        "Ubuntu24": {
          "OSVmImage": "env:LINUXVMIMAGE",
          "Pool": "env:LINUXPOOL",
          "VCPKG_DEFAULT_TRIPLET": "x64-linux",
          "BuildArgs": "-j 10",
          "RunProxyTests": true,
          "CmakeArgs": " -DBUILD_TESTING=ON -DBUILD_PERFORMANCE_TESTS=ON -DRUN_LONG_UNIT_TESTS=ON -DDISABLE_RUST_IN_BUILD=ON"
        }
      },
      "BuildSettings": {
        "gcc_debug": {
          "CMAKE_BUILD_TYPE": "Debug"
        },
        "gcc_release": {
          "CMAKE_BUILD_TYPE": "Release"
        },
        "clang-20_debug": {
          "AptDependencies": "clang-20",
          "CC": "/usr/bin/clang-20",
          "CXX": "/usr/bin/clang++-20",
          "CMAKE_BUILD_TYPE": "Debug"
        }
      }
    },
    {
      "StaticConfigs": {
        "Win2022": {
          "OSVmImage": "env:WINDOWSVMIMAGE",
          "Pool": "env:WINDOWSPOOL",
          "RunProxyTests": true,
          "CMAKE_GENERATOR": "Visual Studio 17 2022",
          "BuildArgs": "--parallel 8 --config Debug"
        }
      },
      "TargetPlatform": {
        "debug_tests_curl": {
          "CmakeArgs": " -DBUILD_TESTING=ON -DBUILD_PERFORMANCE_TESTS=ON -DRUN_LONG_UNIT_TESTS=ON -DBUILD_TRANSPORT_CURL=ON -DMSVC_USE_STATIC_CRT=ON -DDISABLE_RUST_IN_BUILD=ON"
        },
        "debug_tests_winhttp": {
          "CmakeArgs": " -DBUILD_TESTING=ON -DBUILD_PERFORMANCE_TESTS=ON -DRUN_LONG_UNIT_TESTS=ON -DMSVC_USE_STATIC_CRT=ON -DDISABLE_RUST_IN_BUILD=ON"
        }
      },
      "TargetArchitecture": {
        "x86": {
          "CMAKE_GENERATOR_PLATFORM": "Win32",
          "VCPKG_DEFAULT_TRIPLET": "x86-windows-static"
        },
        "x64": {
          "CMAKE_GENERATOR_PLATFORM": "x64",
          "VCPKG_DEFAULT_TRIPLET": "x64-windows-static"
        }
      }
    }
  ]
}
